generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  subtitle    String?
  description String?
  order       Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  ingredients  String?
  price        Float?
  image        String
  badge        String?
  isFeatured   Boolean  @default(false)
  isAvailable  Boolean  @default(true)
  isDemo       Boolean  @default(false)
  order        Int      @default(0)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  caption      String?
  category     String   // Gastronomia, Cafés, Drinks, Sobremesas, Ambiente, Experiências
  image        String   // URL da imagem no storage/public
  aspect       String   @default("portrait") // portrait, landscape, square, wide
  fileName     String?  // Nome do arquivo gerado
  originalSize Int?     // Tamanho original em bytes
  finalSize    Int?     // Tamanho final WebP em bytes
  width        Int?     // Largura em pixels
  height       Int?     // Altura em pixels
  mimeType     String?  @default("image/webp")
  order        Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteConfig {
  id                    String   @id @default("singleton")
  brandName             String   @default("Martita")
  brandTagline          String   @default("CAFÉ & GASTROBAR")
  heroHeadline          String   @default("Um lugar para saborear cada momento.")
  heroSubheadline       String   @default("Do primeiro café da manhã ao último drink da noite. Descubra uma experiência que combina sabores, encontros e bons momentos.")
  heroImage             String   @default("/images/martita/mesa-brunch-compartilhada.jpg")
  heroCtaText           String   @default("Explorar o Cardápio")
  essenceHeadline       String   @default("Mais que uma pausa. Um jeito de aproveitar a vida.")
  essenceSubheadline    String   @default("Onde a arte do café especial, a leveza do brunch e a atmosfera envolvente do gastrobar se encontram em perfeita harmonia.")
  essenceQuote          String   @default("Onde as histórias ficam melhores depois de um drinque.")
  gastrobarHeadline     String   @default("Quando o dia termina, os bons momentos continuam.")
  gastrobarDescription  String   @default("À medida que a luz se transforma, a Martita revela sua alma noturna: drinks autorais, taças brindando, gastronomia para compartilhar e uma atmosfera intimista e acolhedora.")
  address               String   @default("")
  cityState             String   @default("")
  openingHours          String   @default("")
  phone                 String   @default("")
  whatsapp              String   @default("")
  instagram             String   @default("")
  email                 String   @default("")
  mapLat                Float?
  mapLng                Float?
  mapQuery              String   @default("")
  seoTitle              String   @default("Martita — Café, Brunch & Gastrobar | Experiência Gastronômica")
  seoDescription        String   @default("Do primeiro café da manhã ao último drink da noite. Descubra a Martita Café & Gastrobar: brunch autoral, croissants artesanais, almoço executivo e drinks exclusivos.")
  seoKeywords           String   @default("Martita, Café, Gastrobar, Brunch, Croissants, Drinks, Almoço, Gastronomia")
  enableReservations    Boolean  @default(false)
  enableOnlineOrders    Boolean  @default(false)
  enableDelivery        Boolean  @default(false)
  enableCoupons         Boolean  @default(false)
  enableLoyalty         Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==========================================
// ANALYTICS & RASTREAMENTO LGPD-COMPLIANT
// ==========================================

model AnalyticsSession {
  id              String            @id @default(cuid())
  sessionId       String            @unique
  firstSeen       DateTime          @default(now())
  lastSeen        DateTime          @default(now())
  deviceType      String            @default("desktop") // desktop, mobile, tablet
  browser         String?
  os              String?
  country         String?           @default("BR")
  city            String?
  entryPage       String            @default("/")
  exitPage        String?
  channel         String            @default("direct") // instagram, facebook, google_organic, google_ads, whatsapp, direct, external, campaign
  referrer        String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  pageViewsCount  Int               @default(1)
  durationSeconds Int               @default(0)
  isBounce        Boolean           @default(true)
  events          AnalyticsEvent[]
  conversions     ConversionEvent[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([createdAt])
  @@index([channel])
  @@index([deviceType])
  @@index([utmCampaign])
}

model AnalyticsEvent {
  id          String           @id @default(cuid())
  sessionId   String
  session     AnalyticsSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  type        String           @default("pageview") // pageview, click, custom
  page        String
  elementId   String?
  elementText String?
  metadata    String?          @default("{}") // JSON string
  createdAt   DateTime         @default(now())

  @@index([createdAt])
  @@index([page])
  @@index([type])
}

model ConversionEvent {
  id          String            @id @default(cuid())
  sessionId   String?
  session     AnalyticsSession? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)
  type        String            // whatsapp_click, phone_click, instagram_click, contact_submit, menu_view, custom
  name        String            // Nome legível: "Clique no WhatsApp", etc.
  page        String
  channel     String            @default("direct")
  deviceType  String            @default("desktop")
  value       Float?            @default(0)
  metadata    String?           @default("{}")
  createdAt   DateTime          @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([channel])
}

// ==========================================
// MARKETING, CAMPANHAS & INTEGRAÇÕES
// ==========================================

model MarketingCampaign {
  id               String   @id @default(cuid())
  name             String
  destinationUrl   String
  utmSource        String
  utmMedium        String
  utmCampaign      String
  utmContent       String?
  utmTerm          String?
  generatedUrl     String
  clicksCount      Int      @default(0)
  conversionsCount Int      @default(0)
  active           Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([utmCampaign])
  @@index([active])
}

model MarketingIntegration {
  id                 String    @id @default(cuid())
  provider           String    @unique // meta_ads, ga4, gtm, search_console, google_ads
  name               String
  status             String    @default("disconnected") // connected, disconnected, pending
  accountId          String?
  pixelId            String?
  measurementId      String?
  containerId        String?
  conversionId       String?
  conversionLabel    String?
  testEventCode      String?
  apiTokenEncrypted  String?   // Tokens server-side
  lastSyncAt         DateTime?
  config             String?   @default("{}") // JSON config
  enabled            Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model TrackingScript {
  id              String   @id @default(cuid())
  name            String   // ex: Microsoft Clarity, Hotjar, TikTok Pixel
  type            String   @default("custom") // clarity, hotjar, tiktok, pinterest, custom
  code            String   // Snippet HTML/JS
  location        String   @default("head") // head, body_start, body_end
  enabled         Boolean  @default(true)
  consentCategory String   @default("analytics") // necessary, analytics, marketing
  environment     String   @default("production") // all, production, development
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// SEO SUITE & GESTÃO ORGÂNICA
// ==========================================

model PageSeo {
  id                  String   @id @default(cuid())
  route               String   @unique // "/", "/cardapio", "/por-que-um-site-em-2026"
  pageName            String
  title               String?
  description         String?
  focusKeyword        String?
  secondaryKeywords   String?
  canonicalUrl        String?
  metaRobots          String   @default("index, follow")
  ogTitle             String?
  ogDescription       String?
  ogImage             String?
  twitterCard         String   @default("summary_large_image")
  structuredDataJson  String?  @default("{}")
  structuredDataType  String   @default("Restaurant")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([route])
}

model SeoRedirect {
  id         String   @id @default(cuid())
  sourcePath String   @unique
  targetPath String
  statusCode Int      @default(301) // 301 ou 302
  active     Boolean  @default(true)
  hits       Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sourcePath])
  @@index([active])
}

model SeoSettings {
  id                       String    @id @default("singleton")
  robotsTxt                String    @default("User-agent: *\nAllow: /\nDisallow: /admin/\nDisallow: /api/\n\nSitemap: https://martita.com.br/sitemap.xml")
  sitemapEnabled           Boolean   @default(true)
  autoUpdateSitemap        Boolean   @default(true)
  schemaOrganizationJson   String?   @default("{}")
  schemaLocalBusinessJson  String?   @default("{}")
  healthScore              Int       @default(92)
  lastAuditAt              DateTime?
  auditSummary             String?   @default("{}")
  updatedAt                DateTime  @updatedAt
}

model SeoAuditIssue {
  id             String   @id @default(cuid())
  page           String
  category       String   // title, description, heading, image, canonical, indexability, performance
  severity       String   // error, warning, info
  title          String
  explanation    String
  recommendation String
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([severity])
  @@index([resolved])
}

// ==========================================
// NOTIFICAÇÕES & LOGS DE ATIVIDADE
// ==========================================

model AdminNotification {
  id        String   @id @default(cuid())
  type      String   // traffic_spike, traffic_drop, integration_error, seo_issue, contact_lead, system
  severity  String   @default("info") // info, warning, error, success
  title     String
  message   String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String   // login, update_seo, save_campaign, toggle_integration, update_product, etc.
  category    String   // auth, content, marketing, seo, config
  description String
  userName    String   @default("Admin")
  userEmail   String   @default("admin@martita.com.br")
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([category])
}

